  },
  "line-3": {
    "trans": "I’m fine, thank you. I am Ana.",
    "pronunciation": "[ehs-TOY byehn, GRAH-see-ahs. soh AH-nah]"
  },
  "line-4": {
    "trans": "Nice to meet you, Ana.",
    "pronunciation": "[MOO-choh GOOS-toh, ah-NAH]"
  },
