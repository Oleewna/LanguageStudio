  "culture-3": {
    "title": "Culture note"
  },
  "p-1": {
    "text": "In Spanish-speaking settings, it is common to greet each other warmly and casually. A simple “Hola” and “¿Cómo estás?” feel natural from the very first meeting."
  },
  "takeaways-4": {
    "title": "Key takeaways"
  },
  "t-1": {
    "text": "Hola is a natural greeting to begin a conversation."
  },
  "t-2": {
    "text": "¿Cómo estás? means “How are you?”"
  },
  "t-3": {
    "text": "Soy ... means “I am ...”, and Mucho gusto means “Nice to meet you.”"
  },
  "tasks-5": {
    "title": "Lesson tasks"
  },
  "q1": {
    "question": "How do you say “My name is Ana” in Spanish?",
    "options": {
      "opt-1": "Soy Ana.",
      "opt-2": "Estoy Ana.",
      "opt-3": "Mucho gusto."
    }
  },
  "q2": {
    "question": "“Mucho gusto” means “nice to meet you.”"
