  "dialogue-1": {
    "title": "Діалог у класі",
    "story": "Ана приходить на перший урок іспанської й знайомиться з Марією."
  },
  "line-1": {
    "trans": "Привіт!",
    "pronunciation": "[о-ла]"
  },
  "line-2": {
    "trans": "Привіт! Як справи?",
    "pronunciation": "[ко-мо ес-тас]"
  },
  "line-3": {
    "trans": "Я в порядку, дякую. Я Ана.",
    "pronunciation": "[ес-той б'єн, гра-сі-ас. сой а-на]"
  },
  "line-4": {
    "trans": "Приємно познайомитися, Ана.",
    "pronunciation": "[му-чо гу-сто, а-на]"
  },
