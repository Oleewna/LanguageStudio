  "dialogue-1": {
    "title": "Привітаймося",
    "story": "Анна зустрічає Луку й запитує, як у нього справи."
  },
  "line-1": {
    "trans": "Привіт! Як справи?",
    "pronunciation": "[чао! коме стаї]"
  },
  "line-2": {
    "trans": "Добре, дякую! А ти?",
    "pronunciation": "[бене, ґраціє! е ту]"
  },
  "line-3": {
    "trans": "Добре!",
    "pronunciation": "[бене]"
  },
  "vocab-2": {
    "title": "Три корисні фрази"
  },
  "v-1": {
    "trans": "привіт; бувай",
