  "takeaways-3": {
    "title": "Запам’ятайте"
  },
  "t-1": {
    "text": "Ciao — неформальне «привіт»; ним також можна попрощатися."
  },
  "t-2": {
    "text": "Come — «як»; stai — «ти є» (неформально)."
  },
  "t-3": {
    "text": "Bene — «добре»; grazie — «дякую»."
  },
  "t-4": {
    "text": "E — «і»; tu — «ти»."
  },
  "tasks-4": {
    "title": "Швидка практика"
  },
