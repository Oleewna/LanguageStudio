      "lines": [
        {
          "speaker": "Elena",
          "avatar": "E",
          "text": "Ciao! Come ti chiami?",
          "trans": {
            "uk": "Привіт! Як тебе звати?",
            "en": "Hi! What's your name?"
          },
          "audio": true
        },
        {
          "speaker": "Nina",
          "avatar": "N",
          "text": "Mi chiamo Nina. E tu?",
          "trans": {
            "uk": "Мене звати Ніна. А тебе?",
            "en": "My name is Nina. And you?"
          },
          "audio": true
        },
        {
          "speaker": "Elena",
          "avatar": "E",
          "text": "Sono Elena. Di dove sei?",
          "trans": {
            "uk": "Я Олена. Звідки ти?",
            "en": "I'm Elena. Where are you from?"
          },
          "audio": true
        },
        {
          "speaker": "Nina",
          "avatar": "N",
          "text": "Vengo dall'Ucraina. Parlo ucraino e un po' d'italiano.",
          "trans": {
            "uk": "Я з України. Розмовляю українською і трохи італійською.",
            "en": "I'm from Ukraine. I speak Ukrainian and a little Italian."
          },
          "audio": true
        },
        {
          "speaker": "Elena",
          "avatar": "E",
          "text": "Piacere di conoscerti!",
          "trans": {
            "uk": "Приємно познайомитися!",
            "en": "Nice to meet you!"
          },
          "audio": true
        }
      ]
    },
