{
  "id": "communication-basics-2",
  "title": { "uk": "Навчання та робота", "en": "Study and work" },
  "subtitle": { "uk": "Studio o lavoro?", "en": "Studio o lavoro?" },
  "description": {
    "uk": "Скажіть, де ви навчаєтеся або працюєте.",
    "en": "Say what you study or where you work."
  },
  "duration": { "uk": "2 хв", "en": "2 min" },
  "xpReward": 10,
  "prevLessonId": "communication-basics-1-review",
  "nextLessonId": "communication-basics-2-family",
  "blocks": [
    {
      "type": "dialogue",
      "title": { "uk": "Поговорімо про роботу", "en": "Let's talk about work" },
      "lines": [
        {
          "speaker": "Greta",
          "avatar": "G",
          "text": "Studi o lavori?",
          "trans": { "uk": "Ти навчаєшся чи працюєш?", "en": "Do you study or work?" },
          "audio": true
        },
        {
          "speaker": "Sofia",
          "avatar": "S",
          "text": "Studio medicina. E tu?",
          "trans": { "uk": "Я вивчаю медицину. А ти?", "en": "I study medicine. And you?" },
          "audio": true
        },
        {
          "speaker": "Greta",
          "avatar": "G",
          "text": "Lavoro in una libreria.",
          "trans": { "uk": "Я працюю в книгарні.", "en": "I work in a bookshop." },
          "audio": true
        }
      ]
    },
    {
      "type": "vocab",
      "title": { "uk": "Навчання чи робота", "en": "Study or work" },
      "items": [
        {
          "it": "studio",
          "translations": { "uk": "я навчаюся; вивчаю", "en": "I study" }
        },
        {
          "it": "lavoro",
          "translations": { "uk": "я працюю", "en": "I work" }
        },
        {
          "it": "Studi o lavori?",
          "translations": { "uk": "Ти навчаєшся чи працюєш?", "en": "Do you study or work?" }
        }
      ]
    },
    {
      "type": "tasks",
      "title": { "uk": "Перевір себе", "en": "Check yourself" },
      "items": [
        {
          "kind": "choice",
          "id": "study-medicine",
          "q": { "uk": "Як сказати «Я вивчаю медицину»?", "en": "How do you say “I study medicine”?" },
          "options": [
            { "text": { "uk": "Studio medicina.", "en": "Studio medicina." }, "correct": true },
            { "text": { "uk": "Lavoro medicina.", "en": "Lavoro medicina." }, "correct": false },
            { "text": { "uk": "Parlo medicina.", "en": "Parlo medicina." }, "correct": false }
          ]
        },
        {
          "kind": "choice",
          "id": "work-bookshop",
          "q": { "uk": "Що означає «Lavoro in una libreria»?", "en": "What does “Lavoro in una libreria” mean?" },
          "options": [
            { "text": { "uk": "Я працюю в книгарні.", "en": "I work in a bookshop." }, "correct": true },
            { "text": { "uk": "Я навчаюся в університеті.", "en": "I study at a university." }, "correct": false },
            { "text": { "uk": "Я купую книжку.", "en": "I am buying a book." }, "correct": false }
          ]
        },
        {
          "kind": "choice",
          "id": "study-or-work",
          "q": { "uk": "Як перекласти «Studi o lavori?»", "en": "What does “Studi o lavori?” mean?" },
          "options": [
            { "text": { "uk": "Ти навчаєшся чи працюєш?", "en": "Do you study or work?" }, "correct": true },
            { "text": { "uk": "Якими мовами ти розмовляєш?", "en": "Which languages do you speak?" }, "correct": false },
            { "text": { "uk": "Де ти живеш?", "en": "Where do you live?" }, "correct": false }
          ]
        }
      ]
    }
  ]
