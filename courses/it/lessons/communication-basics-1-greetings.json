            "en": "You meet a friend in the evening. Which informal greeting can you use?"
          },
          "options": [
            { "text": { "uk": "Ciao!", "en": "Ciao!" }, "correct": true },
            { "text": { "uk": "Buonasera!", "en": "Buonasera!" } },
            { "text": { "uk": "Buongiorno!", "en": "Buongiorno!" } }
          ]
        }
