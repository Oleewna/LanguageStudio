          "id": "evening-greeting",
          "q": {
            "uk": "Яке привітання найкраще підходить для вечора?",
            "en": "Which greeting is best for the evening?"
          },
          "options": [
            { "text": { "uk": "Buonasera!", "en": "Buonasera!" }, "correct": true },
            { "text": { "uk": "Buongiorno!", "en": "Buongiorno!" } },
            { "text": { "uk": "Ciao!", "en": "Ciao!" } }
          ]
        },
        {
          "kind": "choice",
          "id": "daytime-greeting",
          "q": {
            "uk": "Коли найкраще сказати «Buongiorno»?",
            "en": "When is “Buongiorno” the best choice?"
          },
          "options": [
            { "text": { "uk": "Ввічливе привітання вдень", "en": "A polite greeting during the day" }, "correct": true },
