      "type": "vocab",
      "title": {
        "uk": "Ввічливо привітайтеся",
        "en": "Greet someone politely"
      },
      "items": [
        {
          "it": "Buongiorno!",
          "pronunciation": {
            "uk": "[буонджорно]",
            "en": "[bwon-JOR-noh]"
          },
          "translations": {
            "uk": "Доброго дня!",
            "en": "Good morning! / Good day!"
          }
        },
        {
          "it": "Buonasera!",
          "pronunciation": {
            "uk": "[буонасера]",
            "en": "[bwoh-nah-SEH-rah]"
          },
          "translations": {
            "uk": "Добрий вечір!",
            "en": "Good evening!"
          }
        },
        {
          "it": "Ciao!",
          "pronunciation": {
            "uk": "[чао]",
            "en": "[CHOW]"
          },
          "translations": {
            "uk": "Привіт! / Бувай!",
            "en": "Hi! / Bye!"
          }
        }
      ]
    },
    {
      "type": "takeaways",
      "title": {
        "uk": "Підказка на сьогодні",
        "en": "Today’s tip"
      },
      "items": [
        {
          "uk": "Buongiorno — ввічливе привітання вдень.",
          "en": "Buongiorno is a polite greeting during the day."
        },
        {
          "uk": "Buonasera — ввічливе привітання ввечері.",
          "en": "Buonasera is a polite greeting in the evening."
        },
        {
          "uk": "Ciao — неформальне привітання для друзів.",
          "en": "Ciao is an informal greeting for friends."
        }
      ]
    },
    {
      "type": "tasks",
