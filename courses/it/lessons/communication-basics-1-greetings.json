          "options": [
            { "text": { "uk": "Buongiorno!", "en": "Buongiorno!" }, "correct": true },
            { "text": { "uk": "Buonasera!", "en": "Buonasera!" } },
            { "text": { "uk": "Ciao!", "en": "Ciao!" } }
          ]
        },
        {
          "kind": "choice",
          "id": "friend-evening",
