      "title": {
        "uk": "Познайомтеся",
        "en": "Meet someone"
      },
      "story": {
        "uk": "Анна запитує Марко, як його звати. Він відповідає й запитує у відповідь.",
        "en": "Anna asks Marco his name. He answers and asks her in return."
      },
      "lines": [
        {
          "speaker": "Anna",
          "avatar": "A",
          "text": "Come ti chiami?",
          "pronunciation": {
            "uk": "[коме ті к'ямі]",
            "en": "[KOH-meh tee KYAH-mee]"
          },
          "trans": {
            "uk": "Як тебе звати?",
            "en": "What is your name?"
          }
        },
        {
          "speaker": "Marco",
          "avatar": "M",
          "text": "Mi chiamo Marco. E tu?",
          "pronunciation": {
            "uk": "[мі к'ямо Марко. е ту]",
            "en": "[mee KYAH-moh MAR-koh. eh too]"
          },
          "trans": {
            "uk": "Мене звати Марко. А тебе?",
            "en": "My name is Marco. And you?"
          }
        }
      ]
    },
    {
      "type": "vocab",
      "title": {
        "uk": "Скажіть своє ім’я",
