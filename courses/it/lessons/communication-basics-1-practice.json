          "options": [
            { "text": { "uk": "Di dove sei?", "en": "Di dove sei?" }, "correct": true },
            { "text": { "uk": "Come ti chiami?", "en": "Come ti chiami?" }, "correct": false },
            { "text": { "uk": "Quanti anni hai?", "en": "Quanti anni hai?" }, "correct": false }
          ]
        },
        {
          "kind": "truefalse",
          "id": "profile-origin",
          "q": {
            "uk": "«Parlo» означає «я розмовляю».",
            "en": "“Parlo” means “I speak.”"
          },
          "answer": true
        },
        {
          "kind": "text",
          "id": "say-name",
          "prompt": "Mi chiamo ___.",
          "answers": ["anna", "anna."]
