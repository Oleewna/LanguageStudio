          "options": [
            { "text": { "uk": "Я розмовляю", "en": "I speak" }, "correct": true },
            { "text": { "uk": "Я живу", "en": "I live" }, "correct": false },
            { "text": { "uk": "Я навчаюся", "en": "I study" }, "correct": false }
          ]
        },
        {
          "kind": "choice",
          "id": "profile-city",
          "q": {
            "uk": "Як відповісти на запитання «Di dove sei?»?",
            "en": "How do you answer “Di dove sei?”?"
          },
          "options": [
            { "text": { "uk": "Vengo dall'Ucraina.", "en": "Vengo dall'Ucraina." }, "correct": true },
            { "text": { "uk": "Mi chiamo Anna.", "en": "Mi chiamo Anna." }, "correct": false },
            { "text": { "uk": "Piacere!", "en": "Piacere!" }, "correct": false }
          ]
        }
      ]
    }
  ]
