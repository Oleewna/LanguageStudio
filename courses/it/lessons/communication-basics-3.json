        {
          "speaker": "Greta",
          "avatar": "G",
          "text": "Mi piace ascoltare la musica. E a te?",
          "trans": { "uk": "Мені подобається слухати музику. А тобі?", "en": "I like listening to music. And you?" },
          "audio": true
        },
        {
          "speaker": "Sofia",
          "avatar": "S",
          "text": "Mi piace leggere.",
          "trans": { "uk": "Мені подобається читати.", "en": "I like reading." },
          "audio": true
        }
      ]
    },
