# LanguageStudio Backend Service Environment Configuration

# Server network binding
PORT=3006
HOST=127.0.0.1
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:db_password@your-cluster.mongodb.net/languagestudio?retryWrites=true&w=majority

# Session Configuration
# Secret used by express-session to sign session cookies (use a long random secret in production)
SESSION_SECRET=replace_with_a_secure_random_string_in_production
SESSION_COOKIE_NAME=ls.sid
COOKIE_SECURE=false

# Tunnel & Remote Access Configuration (ngrok)
# NGROK_DOMAIN=your-subdomain.ngrok-free.app
# PUBLIC_URL=https://your-subdomain.ngrok-free.app
# ALLOW_DEV_ENDPOINTS=false

# Payment Webhook Configuration
# PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Google OAuth Configuration
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Rate Limiting & Auth Configuration
ENABLE_RATE_LIMIT=true

# Public Application & OAuth URLs
APP_URL=https://your-name.ngrok-free.app
GOOGLE_REDIRECT_URI=https://your-name.ngrok-free.app/api/v1/auth/google/callback
