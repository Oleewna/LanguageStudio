# LanguageStudio Backend Service Environment Configuration

# Server network binding
PORT=3006
HOST=127.0.0.1
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:db_password@your-cluster.mongodb.net/languagestudio?retryWrites=true&w=majority

# Session Configuration
# Secret used by express-session to sign session cookies (use a long random secret in production)
SESSION_SECRET=replace_with_a_secure_random_string_in_production
SESSION_COOKIE_NAME=ls.sid
COOKIE_SECURE=false

# Rate Limiting & Auth Configuration
ENABLE_RATE_LIMIT=true
