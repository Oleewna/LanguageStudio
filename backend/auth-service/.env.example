PORT=3007
HOST=127.0.0.1
AUTH_USERS_FILE=./data/users.json
# Optional: Path to Google OAuth client secret JSON file (e.g. client_secret_xxx.json)
# If placed in backend/auth-service/ or backend/, it will also be detected automatically.
# GOOGLE_CREDENTIALS_JSON=./client_secret.json

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:3005/api/v1/auth/google/callback
SESSION_SECRET=language-studio-auth-secret-change-in-production
